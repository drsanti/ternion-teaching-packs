          "main.py": "from scores import SCORES\n\ndef count_passing(scores, mark):\n    # How many scores are mark or more?\n    return 0\n\ndef average(scores):\n    # Add them up, then divide by how many there are.\n    return 0\n\ndef highest(scores):\n    # Without max(): keep the best score seen so far.\n    return 0\n\nprint(\"passed:\", count_passing(SCORES, 50))\nprint(\"average:\", average(SCORES))\nprint(\"highest:\", highest(SCORES))\n",
          "scores.py": "# The class's scores, read from the school's file. You can read this file but not change it.\nfrom raw_scores import RAW\n\nSCORES = [int(s) for s in RAW.split()]\n",
          "raw_scores.py": "RAW = \"72 45 88 60 39 95 51\"\n"
        },
        "locked": [
          "scores.py"
        ],
        "hidden": [
          "raw_scores.py"
        ],
        "solution": {
          "main.py": "from scores import SCORES\n\ndef count_passing(scores, mark):\n    count = 0\n    for s in scores:\n        if s >= mark:\n            count = count + 1\n    return count\n\ndef average(scores):\n    total = 0\n    for s in scores:\n        total = total + s\n    return total / len(scores)\n\ndef highest(scores):\n    best = scores[0]\n    for s in scores:\n        if s > best:\n            best = s\n    return best\n\nprint(\"passed:\", count_passing(SCORES, 50))\nprint(\"average:\", average(SCORES))\nprint(\"highest:\", highest(SCORES))\n"
        },
