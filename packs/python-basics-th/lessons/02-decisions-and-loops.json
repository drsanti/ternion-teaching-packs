        "files": {
          "main.py": "from scores import SCORES\n\ndef count_passing(scores, mark):\n    # มีกี่คะแนนที่ได้ตั้งแต่ mark ขึ้นไป\n    return 0\n\ndef average(scores):\n    # บวกทั้งหมด แล้วหารด้วยจำนวนคะแนน\n    return 0\n\ndef highest(scores):\n    # ห้ามใช้ max(): เก็บคะแนนที่สูงที่สุดที่เจอมาจนถึงตอนนี้\n    return 0\n\nprint(\"passed:\", count_passing(SCORES, 50))\nprint(\"average:\", average(SCORES))\nprint(\"highest:\", highest(SCORES))\n",
          "scores.py": "# คะแนนของชั้นเรียน อ่านจากไฟล์ของโรงเรียน อ่านไฟล์นี้ได้แต่แก้ไม่ได้\nfrom raw_scores import RAW\n\nSCORES = [int(s) for s in RAW.split()]\n",
          "raw_scores.py": "RAW = \"72 45 88 60 39 95 51\"\n"
        },
        "locked": [
          "scores.py"
        ],
        "hidden": [
          "raw_scores.py"
        ],
        "solution": {
          "main.py": "from scores import SCORES\n\ndef count_passing(scores, mark):\n    count = 0\n    for s in scores:\n        if s >= mark:\n            count = count + 1\n    return count\n\ndef average(scores):\n    total = 0\n    for s in scores:\n        total = total + s\n    return total / len(scores)\n\ndef highest(scores):\n    best = scores[0]\n    for s in scores:\n        if s > best:\n            best = s\n    return best\n\nprint(\"passed:\", count_passing(SCORES, 50))\nprint(\"average:\", average(SCORES))\nprint(\"highest:\", highest(SCORES))\n"
        },
        "solutionGate": "after-trying",
